# Copy values into Render > Environment. Do NOT commit real secrets.
CLOUD_API_TOKEN=replace-with-a-long-random-token
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
CLOUD_SESSION_HOURS=12
CLOUD_PUBLIC_DASHBOARD=false

# Optional. On a paid Render service with a persistent disk mounted at /var/data:
# CLOUD_DATA_DIR=/var/data
